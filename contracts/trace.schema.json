{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nationwide.com/ssd-dast-poc/contracts/trace.schema.json",
  "title": "Recording trace",
  "description": "Output of the record CLI (FR-R1/R2/R3): the pages, interactions, forms, API calls, and hosts observed while crawling the pilot app. Consumed by generate to author the journey plan.",
  "type": "object",
  "additionalProperties": false,
  "required": ["app_id", "base_url", "hosts", "index", "interactions"],
  "properties": {
    "app_id": {"type": "string", "minLength": 1},
    "base_url": {"type": "string", "minLength": 1, "description": "Target as the crawler reached it, e.g. http://juice:3000"},
    "hosts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true,
      "description": "Distinct hosts observed; seeds the scope allow-list (FR-G2)."
    },
    "index": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Pages/routes visited (FR-R1)."
    },
    "interactions": {
      "type": "array",
      "description": "Ordered interactions incl. the login sequence (FR-R1/R2).",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {"type": {"type": "string"}},
        "additionalProperties": true
      }
    },
    "forms": {
      "type": "array",
      "description": "Discovered forms and their fields (FR-R3).",
      "items": {
        "type": "object",
        "required": ["url", "fields"],
        "properties": {
          "url": {"type": "string"},
          "fields": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "api": {
      "type": "array",
      "description": "Observed XHR/API requests (FR-R3).",
      "items": {
        "type": "object",
        "required": ["method", "url"],
        "properties": {
          "method": {"type": "string"},
          "url": {"type": "string"},
          "params": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  }
}
