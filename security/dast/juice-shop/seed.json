{
  "target": {
    "base_url": "http://juice:3000",
    "scope_file": "security/dast/juice-shop/scope.json"
  },
  "session": {
    "storage_state": ".secrets/storageState.json"
  },
  "seed_routes": [
    "/#/basket",
    "/#/order-history",
    "/#/privacy-security/privacy-policy"
  ],
  "deny_actions": [
    "logout",
    "delete-account",
    "purchase",
    "change-password",
    "administration"
  ],
  "exploration": {
    "max_pages": 12
  }
}
