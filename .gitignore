# Python
__pycache__/
*.pyc
.venv/
venv/
.env

# Seeded sessions (live auth secrets: cookies + tokens) — never commit
.secrets/

# Scan outputs / evidence (do NOT commit secrets or raw evidence)
*.har
evidence/
*.zap
zap-report.*

# OS / editor
.DS_Store
.idea/
.vscode/

# Runner output
out/

# Copilot prompt/response scratch dirs (deleted after each call; ignored if a run is killed)
.dast-copilot-*/

# Corporate CA bundle staged for the runner image build (scripts/stage_ca_bundle.sh)
certs/*
!certs/README.md

# A stray archive once committed at the root by `tar ... -f -` going to a file named "-"
/-
