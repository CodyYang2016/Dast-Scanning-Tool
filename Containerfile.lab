# Image for the stdlib-only lab targets (labs/), kept separate from the runner image on purpose:
# the runner's `pip install` needs PyPI, and on an operator machine behind TLS interception that
# build fails — which has nothing to do with running a lab that imports only the standard library.
# Same base as the runner (versions.lock: runner_base_image), so no second image is downloaded.
FROM mcr.microsoft.com/playwright/python:v1.62.0-jammy

WORKDIR /app
COPY labs/ labs/

ENV PYTHONPATH=/app

# The lab to run and its port come from compose.
ENTRYPOINT ["python"]
