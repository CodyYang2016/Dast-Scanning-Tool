# Site settings for the DAST tool, with the values the Nationwide workstation uses.
#
#   cp env.example .env        # .env is git-ignored; edit it, never commit it
#   source .env                # in Git Bash, from the repo root, in every new terminal
#
# Taken from what the Nationwide account changed on parallel-poc-branch (PRs #28-#35 and the
# runbooks before them) and checked against what main reads today. Active lines are Nationwide's
# known values. Commented lines are optional or unknown (?), with the default that applies when
# they're unset. Leave a setting commented rather than blank: some readers treat "" as a value
# (an empty COPILOT_FLAGS, for example, drops every default flag).
#
# Secrets never go in this file. Each one says where it comes from.
# More: docs/nationwide_test_checklist.md, docs/podman_and_docker.md.

# --- Workstation -----------------------------------------------------------------------------
# Repo checkout used by the checklist: ~/poc-work/ssd-dast-tool-poc (fork: NationwideDevin)
# Podman's WSL VM. Read by prepull_playwright_podman_nationwide.sh.
export PODMAN_MACHINE_NAME=podman-machine-default
# docker | podman. Default: Docker if `docker info` works, else Podman (scripts/ui_stack.sh).
export DAST_CONTAINER_ENGINE=podman
# podman-compose.exe when it's not on PATH. cleanup_demo_ports.sh tries this before its own
# fallback, a hardcoded per-user path (/c/Users/yangq4/AppData/Roaming/Python/Python312/...).
# export COMPOSE_EXE="$HOME/AppData/Roaming/Python/Python312/Scripts/podman-compose.exe"

# --- Images: NTR, the Nationwide Trusted Registry --------------------------------------------
# Log in once: podman login ntr.nwie.net -u <your-nwie-userid>
# NTR (Harbor) redirects image layers to AWS S3, so a pull touches an external host too.
# Every image becomes ntr.nwie.net/<registry>/<path> with versions.lock's digest (scripts/images.sh).
# Check what NTR has: bash scripts/check_images.sh --pull
export DAST_IMAGE_MIRROR=ntr.nwie.net
# One image by hand (wins over the mirror, but must still be under it while the mirror is set).
# Default: the pins in versions.lock. NTR has had no Juice Shop copy at times; see the checklist.
# export ZAP_IMAGE=ntr.nwie.net/docker.io/zaproxy/zap-stable
# export JUICE_IMAGE=ntr.nwie.net/docker.io/bkimminich/juice-shop
# export DVWA_IMAGE=
# export WEBGOAT_IMAGE=
# export RUNNER_BASE_IMAGE=ntr.nwie.net/mcr.microsoft.com/playwright/python:v1.62.0-jammy
# The image the prepull script caches. Default: RUNNER_BASE_IMAGE.
# export PLAYWRIGHT_IMAGE=

# --- Packages: Artifactory -------------------------------------------------------------------
# pip inside the runner image (compose build arg) and in the demo scripts. The proxy blocks
# files.pythonhosted.org. Default in compose.yaml: https://pypi.org/simple
export PIP_INDEX_URL=https://art.nwie.net/artifactory/api/pypi/pypi/simple
# npm, if Node is ever needed (the UI's front end is committed, so normally it isn't):
#   npm config set registry https://art.nwie.net/artifactory/api/npm/npm/
# History: the branch once set PIP_TRUSTED_HOST=art.nwie.net; trusting the CA below replaced it.

# --- TLS: the corporate CA -------------------------------------------------------------------
# PEM text, one or more BEGIN CERTIFICATE blocks. Staged into the runner image by
# scripts/stage_ca_bundle.sh (its default is this path).
export DAST_CA_BUNDLE="$HOME/certs/nw-ca-all.pem"
# Host-side trust for the same proxy: Python (api.github.com, LLM calls) and Node/Playwright's
# browser download. Node wants a Windows path in Git Bash, hence cygpath.
export SSL_CERT_FILE="$DAST_CA_BUNDLE"
export REQUESTS_CA_BUNDLE="$DAST_CA_BUNDLE"
export NODE_EXTRA_CA_CERTS="$(cygpath -w "$DAST_CA_BUNDLE" 2>/dev/null || echo "$DAST_CA_BUNDLE")"

# --- Proxy -----------------------------------------------------------------------------------
# What the prepull script sets. It also removes the stale 127.0.0.1:8888 proxy that the Podman
# VM ships with; if a pull says "proxyconnect tcp: dial tcp 127.0.0.1:8888", rerun it.
export NO_PROXY="nwie.net,localhost,127.0.0.1,.nwie.net,.apps.nwie.net,.docker.internal,kubernetes.docker.internal"
export no_proxy="$NO_PROXY"
# ? The outbound proxy, if this workstation needs one set explicitly. Not passed into containers.
# export HTTPS_PROXY=
# export HTTP_PROXY=

# --- ZAP and the container network ------------------------------------------------------------
# Required: ZAP refuses to start without a key. A fresh one each terminal, as the checklist does;
# keep one already exported. Never printed.
export ZAP_API_KEY="${ZAP_API_KEY:-$(openssl rand -hex 24)}"
# Ports. Leave unset for demo_*.sh, which use 8080 and 3000; set only if those are taken.
# ZAP's port is the same inside and outside the container, or its API answers 502.
# export DAST_ZAP_PORT=8080
# export DAST_JUICE_PORT=3000
# Where the host-run dast commands reach ZAP. Default: http://localhost:8080
# export DAST_ZAP_API=http://127.0.0.1:8080
# Who may call ZAP's API (regex). Default admits only the runner and loopback; ui_stack.sh widens
# it to '.*' for the host-run browser (the key is still required).
# export ZAP_API_ALLOW='.*'
# ? The container subnet and the runner's fixed address. Change if 172.28.0.0/24 clashes with a
# VPN route. Only demo_replay_flow.sh and demo_full_scan.sh read these; compose.yaml has them fixed.
# export DAST_SUBNET=172.28.0.0/24
# export DAST_RUNNER_IP=172.28.0.10

# --- LLM -------------------------------------------------------------------------------------
# Nationwide policy blocks direct Anthropic API calls ("Access Blocked by Policy"), so the
# approved route is the GitHub Copilot CLI. Default: anthropic.
export LLM_PROVIDER=copilot
# Secret: export COPILOT_GITHUB_TOKEN="$(cat .secrets/copilot.token)"   (.secrets/ is git-ignored)
# The CLI, if `copilot` isn't on PATH (a Windows .cmd shim works).
# export COPILOT_CLI=copilot
# Default: gpt-5.5
# export COPILOT_MODEL=gpt-5.5
# Default: the non-interactive flags in authoring/llm_backend.py. Setting this replaces them all.
# export COPILOT_FLAGS=
# Seconds per call. Default: the caller's own timeout.
# export COPILOT_TIMEOUT_SECONDS=
# Print the model's raw replies when one can't be parsed.
# export LLM_DEBUG=1
# The alternative outside Nationwide: LLM_PROVIDER=anthropic, with
#   ANTHROPIC_API_KEY="$(cat .secrets/anthropic.key)"   and optionally ANTHROPIC_MODEL (default claude-opus-4-8)

# --- GitHub: publishing findings ---------------------------------------------------------------
# ? GitHub Enterprise Server's API, if the target repo isn't on github.com. Default: https://api.github.com
# export GITHUB_API_URL=
# Secret, typed, never pasted: read -rs GITHUB_TOKEN && export GITHUB_TOKEN   (or GH_TOKEN, or gh's login)
# Where findings go (--owner/--repo win). Use a sandbox repo, not a real app's.
# export DAST_GH_OWNER=NationwideDevin
# export DAST_GH_REPO=
# The deployed commit and ref a code-scanning upload is filed against; normally set by the deploy
# pipeline. No defaults: an upload with either unset refuses to run.
# export DAST_TARGET_COMMIT=
# export DAST_TARGET_REF=
# Where evidence is hosted, so an alert links to it (http(s) only).
# export DAST_EVIDENCE_URL=

# --- Runs ------------------------------------------------------------------------------------
# Defaults: security/dast, <repo>/out, security/dast/environments.yaml, high.
# export DAST_APPS_DIR=
# export DAST_OUT=
# export DAST_ENV_REGISTRY=
# Where an app's OpenAPI spec is mounted inside ZAP. compose sets /zap/specs for its own runner.
# export DAST_ZAP_SPEC_DIR=
# critical | high | medium | low | none: which new findings fail `dast report`.
# export DAST_FAIL_ON=high
# Also write run events to stderr as JSON, for a log shipper.
# export DAST_LOG_FORMAT=json

# --- Test accounts for the bundled targets (generated or local, never real credentials) ---------
# Juice Shop self-registers, so any fresh pair works:
# export AUTH_EMAIL="nw-$(openssl rand -hex 3)@juice-sh.op" AUTH_PASSWORD="$(openssl rand -hex 10)"
# DVWA's built-in account (after /setup.php -> Create / Reset Database):
# export DVWA_USER=admin DVWA_PASS=password
# The semantic-gate lab (docs checklist step 8):
# export SEMGATE_USER= SEMGATE_PASS=
